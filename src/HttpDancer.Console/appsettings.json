    "UrlPaths": [
      "hrefs.txt"
    ],
    "ExcludedPathParts": ["~"]
  },
  "RatedScheduleRunner": {
    "BatchTolerance": "00:00:00.000",
    "SkipNegativeOffsets": false,
    "MaxDegreeOfParallelism": 100,
    "BoundedCapacity": null,
    "DefaultOptions": {
      "Capacity": 10,
      "Rate": 10,
      "RateWindow": "00:01:00",
      "MinDuration": null
    }    
  }

