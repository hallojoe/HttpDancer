{
  "HttpDancer": {
    "AllowedHosts": "sst.dk, *.sst.dk",
    "AllowedContentTypes": "text/*, image/*, audio/*, video/*, application/pdf, application/zip, application/msword, application/vnd.*",
    "MaxConcurrentRequests": 100,
    "MaxRequests": 100,
    "ReadBodyOnSuccess": true,
    "ReadBodyOnNonSuccess": true,
    "IncludeCorrelationIdHeader": true,
    "CorrelationIdHeaderName": "X-Correlation-Id",
    "HttpClient": {
      "Timeout": "00:02:00",
      "UserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36"
    },
    "SocketsHttpHandler": {
      "MaxConnectionsPerServer": 20,
      "PooledConnectionLifetime": "00:01:00",
      "PooledConnectionIdleTimeout": "00:00:30",
      "AutomaticDecompression": "GZip, Deflate",
      "ConnectTimeout": "00:00:05",
      "EnableMultipleHttp2Connections": true,
      "AllowAutoRedirect": false,
      "UseCookies": false,
      "KeepAlivePingDelay": "00:00:30",
      "KeepAlivePingTimeout": "00:00:10",
      "KeepAlivePingPolicy": "Always"
    }
  },
  "HttpDancer.FileSystemDownloader": {
    "Workspace": "c:\\temp\\sst.dk\\",
    "UrlPaths": [
      "hrefs.txt"
    ],
    "ExcludedPathParts": ["~"]
  },
  "HttpDancer.HtmlQuerying": {
    "Enabled": true,
    "BaseUrl": "https://etiskraad.dk/",
    "PreservedTags": ["a", "img", "iframe", "embed"],
    "Queries": [
      {
        "Alias": "pageTag",
        "Selectors": [ "ul[itemtype='https://schema.org/BreadcrumbList'] li:nth-of-type(3) a > span" ],
        "ValueStrategy": "Text"
      },
      {
        "Alias": "pageImage",
        "Selectors": [ ".plh-top .span-9" ],
        "ValueStrategy": "InnerHtml"
      },
      {
        "Alias": "pageMetaTitle",
        "Selectors": [ "title", ".title" ],
        "ValueStrategy": "Text"
      },
      {
        "Alias": "pageMetaTitleOg",
        "Selectors": [ "meta[property='og:title']" ],
        "ValueStrategy": "Attribute",
        "AttributeName": "content"
      },
      {
        "Alias": "pageMetaDescriptionOg",
        "Selectors": [ "meta[property='og:description']" ],
        "ValueStrategy": "Attribute",
        "AttributeName": "content"
      },
      {
        "Alias": "pageMetaUrlOg",
        "Selectors": [ "meta[property='og:url']" ],
        "ValueStrategy": "Attribute",
        "AttributeName": "content"
      },
      {
        "Alias": "pageMetaImageOg",
        "Selectors": [ "meta[property='og:image']" ],
        "ValueStrategy": "Attribute",
        "AttributeName": "content"
      },
      {
        "Alias": "pageMetaImageWidthOg",
        "Selectors": [ "meta[property='og:image:width']" ],
        "ValueStrategy": "Attribute",
        "AttributeName": "content"
      },
      {
        "Alias": "pageMetaImageHeightOg",
        "Selectors": [ "meta[property='og:image:height']" ],
        "ValueStrategy": "Attribute",
        "AttributeName": "content"
      },
      {
        "Alias": "pageMetaUrlOg",
        "Selectors": [ "meta[property='og:url']" ],
        "ValueStrategy": "Attribute",
        "AttributeName": "content"
      },
      {
        "Alias": "pageMetaTitleX",
        "Selectors": [ "meta[property='twitter:title']" ],
        "ValueStrategy": "Attribute",
        "AttributeName": "content"
      },
      {
        "Alias": "pageMetaDescriptionX",
        "Selectors": [ "meta[property='twitter:description']" ],
        "ValueStrategy": "Attribute",
        "AttributeName": "content"
      },
      {
        "Alias": "pageMetaImageX",
        "Selectors": [ "meta[property='twitter:image']" ],
        "ValueStrategy": "Attribute",
        "AttributeName": "content"
      },
      {
        "Alias": "pageMetaCardX",
        "Selectors": [ "meta[property='twitter:card']" ],
        "ValueStrategy": "Attribute",
        "AttributeName": "content"
      },
      {
        "Alias": "description",
        "Selectors": [ "meta[name='description']", "" ],
        "ValueStrategy": "Attribute",
        "AttributeName": "content"
      },
      {
        "Alias": "contentTitle",
        "Selectors": [ "h1.heading", "h1" ],
        "ValueStrategy": "Text"
      },
      {
        "Alias": "contentDate",
        "Selectors": [ ".news-page .date", ".date" ],
        "ValueStrategy": "Text",
        "ValueInstructions": "ParseDate"
      },
      {
        "Alias": "contentTags",
        "Selectors": [ ".news-page .labels", ".labels" ],
        "ValueStrategy": "Text"
      },
      {
        "Alias": "contentLead",
        "Selectors": [ ".lead" ],
        "ValueStrategy": "InnerHtml"
      },
      {
        "Alias": "contentArea",
        "Selectors": [ ".news-page .text", ".plh-main .text" ],
        "ValueStrategy": "OuterHtml",
        "ValueInstructions": "RemoveAttributes,AbsoluteUrls,Trim"
      }
      
    ]
  },
  "Minification": {
    "Enabled": false,
    "RemoveSelectors": ["script", "style", "header" ,"footer", "svg", "div[data-available-cookies]", ".tool-section", ".aspNetHidden", "input", "textarea"],
    "RemoveComments": true,
    "RemoveEmptyElements": true,
    "NormalizeTextNodes": true
  },
  "HttpDancer.UrlNamingOptions": {
    "TrailingSlash": "Ignore",
    "QueryStringStrategy": "Hash",
    "QueryParts": "None",
    "ExtensionStrategy": "PageVsAsset",
    "RootNamingStrategy": "UseFixedName",
    "IndexDocumentStrategy": "TreatAsFolder",
    "CasingStrategy": "LowercaseInvariant",
    "DecodingStrategy": "DecodeAndNormalize",
    "SlugStrategy": "StrictSlug",
    "NormalizationSteps": "UrlDecode,Slugify,Trim",
    "HostStrategy": "IgnoreHost",
    "PathComponents": "None",
    "FixedRootName": "index",
    "DefaultDocumentNames": [ "index", "default" ],
    "PageExtensions": [ ".html", ".htm", ".aspx" ],
    "ExcludedPathSegments": [],
    "IgnoredQueryKeys": [],
    "MaxNameLength": 133,
    "ReplacementChar": "-",
    "AllowCollisionDisambiguation": true
  }
}
