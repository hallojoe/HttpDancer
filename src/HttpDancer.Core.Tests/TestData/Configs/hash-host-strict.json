{
  "TrailingSlash": "NormalizeWithoutSlash",
  "QueryStringStrategy": "Hash",
  "QueryParts": "Keys,Values,SortKeys,Lowercase",
  "ExtensionStrategy": "PageVsAsset",
  "RootNamingStrategy": "UseFixedName",
  "IndexDocumentStrategy": "TreatAsFile",
  "CasingStrategy": "LowercaseInvariant",
  "DecodingStrategy": "DecodeAndNormalize",
  "SlugStrategy": "StrictSlug",
  "HostStrategy": "IncludeHost",
  "NormalizationSteps": "UrlDecode,UnicodeNormalize,Trim,Slugify,ToLower",
  "PathComponents": "Host,QueryHash",
  "FixedRootName": "index",
  "DefaultDocumentNames": [ "index", "default" ],
  "PageExtensions": [ ".html", ".htm", ".aspx" ],
  "ExcludedPathSegments": [],
  "IgnoredQueryKeys": [ "utm_source", "utm_campaign" ],
  "MaxNameLength": 128,
  "ReplacementChar": "-",
  "AllowCollisionDisambiguation": true
}
